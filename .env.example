# Wallet - NEVER commit actual private keys
WALLET_PRIVATE_KEY=your_base58_private_key_here

# Helius API
HELIUS_API_KEY=your_helius_api_key_here
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key_here
HELIUS_RPC_URL_DEVNET=https://devnet.helius-rpc.com/?api-key=your_helius_api_key_here

# Birdeye API (fallback price data)
BIRDEYE_API_KEY=your_birdeye_api_key_here

# Jupiter API (no key needed, public)
JUPITER_API_URL=https://quote-api.jup.ag/v6

# Notifications (optional)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Database
DB_PATH=./data/trades.db

# Logging
LOG_LEVEL=info
