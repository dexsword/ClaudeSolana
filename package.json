{
  "name": "solana-swing-bot",
  "version": "2.1.0",
  "description": "Solana RSI+VWAP swing trading bot",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "dry-run": "ts-node src/index.ts --dry-run",
    "test": "jest --forceExit",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "backtest": "npx ts-node src/backtest.ts",
    "backtest-bot2": "npx ts-node src/backtestBot2.ts",
    "walkforward-bot2": "npx ts-node src/walkforwardBot2.ts",
    "optimize-bot2": "npx ts-node src/optimizeBot2.ts",
    "optimize": "npx ts-node src/optimize.ts"
  },
  "dependencies": {
    "@solana/web3.js": "^1.91.8",
    "axios": "^1.6.8",
    "better-sqlite3": "^9.4.3",
    "bs58": "^5.0.0",
    "discord.js": "^14.25.1",
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@solana/spl-token": "^0.4.14",
    "@types/better-sqlite3": "^7.6.8",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.30",
    "@types/node-cron": "^3.0.11",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/index.ts"
    ]
  }
}
